  // --- Workspace Switcher (managed by io.github.woogy7.workspaces; re-run `switcher-config menu install` to refresh) ---
  // Setup > Workspace Switcher: every setting of the switcher as an Omarchy menu.
  // Rows re-open their submenu after acting so the ✓ marks update in place.
  "setup.workspace-switcher": {"icon":"󰕰","label":"Workspace Switcher","aliases":["workspace-switcher","switcher"]},
  "setup.workspace-switcher.open": {"icon":"󰕰","label":"Open switcher","action":"omarchy-shell shell toggle io.github.woogy7.workspaces"},
  "setup.workspace-switcher.bar": {"icon":"󰍜","label":"Show in bar","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config bar status)\" == \"on\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config bar toggle; omarchy menu summon setup.workspace-switcher"},

  "setup.workspace-switcher.layout": {"icon":"󰕮","label":"Layout","title":"Layout"},
  "setup.workspace-switcher.layout.ribbon": {"icon":"󰕭","label":"Ribbon","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get layout)\" == \"ribbon\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set layout ribbon; omarchy menu summon setup.workspace-switcher.layout"},
  "setup.workspace-switcher.layout.carousel": {"icon":"󰑒","label":"Carousel","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get layout)\" == \"carousel\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set layout carousel; omarchy menu summon setup.workspace-switcher.layout"},

  "setup.workspace-switcher.tap": {"icon":"󰌌","label":"Tap action","title":"Tap action"},
  "setup.workspace-switcher.tap.browse": {"icon":"󰍉","label":"Browse","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get tapAction)\" == \"browse\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set tapAction browse; omarchy menu summon setup.workspace-switcher.tap"},
  "setup.workspace-switcher.tap.switch": {"icon":"󰒭","label":"Switch","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get tapAction)\" == \"switch\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set tapAction switch; omarchy menu summon setup.workspace-switcher.tap"},

  "setup.workspace-switcher.size": {"icon":"󰩨","label":"Preview size","title":"Preview size"},
  "setup.workspace-switcher.size.240": {"icon":"󰩨","label":"Small","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get previewWidth)\" == \"240\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set previewWidth 240; omarchy menu summon setup.workspace-switcher.size"},
  "setup.workspace-switcher.size.320": {"icon":"󰩨","label":"Medium","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get previewWidth)\" == \"320\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set previewWidth 320; omarchy menu summon setup.workspace-switcher.size"},
  "setup.workspace-switcher.size.360": {"icon":"󰩨","label":"Large","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get previewWidth)\" == \"360\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set previewWidth 360; omarchy menu summon setup.workspace-switcher.size"},
  "setup.workspace-switcher.size.440": {"icon":"󰩨","label":"Extra large","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get previewWidth)\" == \"440\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set previewWidth 440; omarchy menu summon setup.workspace-switcher.size"},
  "setup.workspace-switcher.size.560": {"icon":"󰩨","label":"Huge","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get previewWidth)\" == \"560\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set previewWidth 560; omarchy menu summon setup.workspace-switcher.size"},

  "setup.workspace-switcher.gap": {"icon":"󰹞","label":"Gap","title":"Gap"},
  "setup.workspace-switcher.gap.12": {"icon":"󰹞","label":"Tight","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get gap)\" == \"12\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set gap 12; omarchy menu summon setup.workspace-switcher.gap"},
  "setup.workspace-switcher.gap.20": {"icon":"󰹞","label":"Snug","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get gap)\" == \"20\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set gap 20; omarchy menu summon setup.workspace-switcher.gap"},
  "setup.workspace-switcher.gap.28": {"icon":"󰹞","label":"Normal","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get gap)\" == \"28\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set gap 28; omarchy menu summon setup.workspace-switcher.gap"},
  "setup.workspace-switcher.gap.44": {"icon":"󰹞","label":"Roomy","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get gap)\" == \"44\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set gap 44; omarchy menu summon setup.workspace-switcher.gap"},

  "setup.workspace-switcher.monitors": {"icon":"󰍹","label":"Monitors","title":"Monitors"},
  "setup.workspace-switcher.monitors.all": {"icon":"󰍺","label":"All","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get monitors)\" == \"all\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set monitors all; omarchy menu summon setup.workspace-switcher.monitors"},
  "setup.workspace-switcher.monitors.focused": {"icon":"󰍹","label":"Focused only","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get monitors)\" == \"focused\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set monitors focused; omarchy menu summon setup.workspace-switcher.monitors"},

  "setup.workspace-switcher.workspaces": {"icon":"󰕰","label":"Workspaces shown","title":"Workspaces shown"},
  "setup.workspace-switcher.workspaces.1": {"icon":"󰲠","label":"Only existing","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get minWorkspaces)\" == \"0\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set minWorkspaces 0; omarchy menu summon setup.workspace-switcher.workspaces"},
  "setup.workspace-switcher.workspaces.3": {"icon":"󰲤","label":"Always 1–3","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get minWorkspaces)\" == \"3\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set minWorkspaces 3; omarchy menu summon setup.workspace-switcher.workspaces"},
  "setup.workspace-switcher.workspaces.5": {"icon":"󰲨","label":"Always 1–5","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get minWorkspaces)\" == \"5\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set minWorkspaces 5; omarchy menu summon setup.workspace-switcher.workspaces"},
  "setup.workspace-switcher.workspaces.10": {"icon":"󰿬","label":"Always 1–10","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get minWorkspaces)\" == \"10\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set minWorkspaces 10; omarchy menu summon setup.workspace-switcher.workspaces"},

  "setup.workspace-switcher.look": {"icon":"󰸌","label":"Look","title":"Look"},
  "setup.workspace-switcher.look.wallpaper": {"icon":"󰸉","label":"Wallpaper","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get showWallpaper)\" == \"true\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config toggle showWallpaper; omarchy menu summon setup.workspace-switcher.look"},
  "setup.workspace-switcher.look.labels": {"icon":"󰦨","label":"Labels","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get showLabels)\" == \"true\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config toggle showLabels; omarchy menu summon setup.workspace-switcher.look"},
  "setup.workspace-switcher.look.hints": {"icon":"󰋽","label":"Key hints","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get showHints)\" == \"true\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config toggle showHints; omarchy menu summon setup.workspace-switcher.look"},
  "setup.workspace-switcher.look.hover": {"icon":"󰍽","label":"Hover selects","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get hoverSelects)\" == \"true\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config toggle hoverSelects; omarchy menu summon setup.workspace-switcher.look"},

  "setup.workspace-switcher.emphasis": {"icon":"󰐗","label":"Selected emphasis","title":"Selected emphasis"},
  "setup.workspace-switcher.emphasis.flat": {"icon":"󰝦","label":"Flat","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get selectedScale)\" == \"1.0\" && \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get unselectedOpacity)\" == \"1.0\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set selectedScale 1.0; ~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set unselectedOpacity 1.0; ~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set unselectedScale 1.0; omarchy menu summon setup.workspace-switcher.emphasis"},
  "setup.workspace-switcher.emphasis.gentle": {"icon":"󰝥","label":"Gentle","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get selectedScale)\" == \"1.04\" && \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get unselectedOpacity)\" == \"0.7\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set selectedScale 1.04; ~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set unselectedOpacity 0.7; ~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set unselectedScale 1.0; omarchy menu summon setup.workspace-switcher.emphasis"},
  "setup.workspace-switcher.emphasis.strong": {"icon":"󰝤","label":"Strong","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get selectedScale)\" == \"1.08\" && \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get unselectedOpacity)\" == \"0.5\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set selectedScale 1.08; ~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set unselectedOpacity 0.5; ~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set unselectedScale 0.94; omarchy menu summon setup.workspace-switcher.emphasis"},

  "setup.workspace-switcher.animations": {"icon":"󰑓","label":"Animations","title":"Animations"},
  "setup.workspace-switcher.animations.on": {"icon":"󰐊","label":"Enabled","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get animations)\" == \"true\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config toggle animations; omarchy menu summon setup.workspace-switcher.animations"},
  "setup.workspace-switcher.animations.fast": {"icon":"󰓅","label":"Fast","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get animationDuration)\" == \"90\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set animationDuration 90; ~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set fadeDuration 80; omarchy menu summon setup.workspace-switcher.animations"},
  "setup.workspace-switcher.animations.normal": {"icon":"󰾅","label":"Normal","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get animationDuration)\" == \"160\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set animationDuration 160; ~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set fadeDuration 140; omarchy menu summon setup.workspace-switcher.animations"},
  "setup.workspace-switcher.animations.slow": {"icon":"󰾆","label":"Slow","checked":"[[ \"$(~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config get animationDuration)\" == \"260\" ]]","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set animationDuration 260; ~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config set fadeDuration 220; omarchy menu summon setup.workspace-switcher.animations"},

  "setup.workspace-switcher.reset": {"icon":"󰦛","label":"Reset to defaults","action":"~/.config/omarchy/plugins/io.github.woogy7.workspaces/switcher-config reset; omarchy menu summon setup.workspace-switcher"},
  "setup.workspace-switcher.edit": {"icon":"","label":"Edit shell.json","action":"omarchy-launch-config-editor \"$HOME/.config/omarchy/shell.json\""},
  "setup.workspace-switcher.keybindings": {"icon":"","label":"Edit keybindings","action":"omarchy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.workspace-switcher.docs": {"icon":"","label":"Documentation","action":"omarchy-launch-webapp 'https://github.com/Woogy7/omarchy-workspace-switcher'"},
  // --- end Workspace Switcher ---
