#!/usr/bin/env python3
"""Read/write Workspace Switcher settings in ~/.config/omarchy/shell.json.

Settings live inline on the plugin's entry in `plugins[]`; omarchy-shell watches
the file, so changes apply live.

  switcher-config get <key>            print the effective value (default if unset)
  switcher-config set <key> <value>    set (numbers/booleans are typed automatically)
  switcher-config toggle <key>         flip a boolean
  switcher-config unset <key>          drop the key (back to default)
  switcher-config show                 print effective settings as JSON
  switcher-config reset                drop every setting
  switcher-config bar [on|off|toggle|status]  show/hide the bar icon (adds/removes the
                                       bar.layout entry; default section: right)
  switcher-config menu [install|remove|status]
                                       add/remove the Setup > Workspace Switcher block in
                                       ~/.config/omarchy/extensions/omarchy-menu.jsonc
                                       (marker-delimited; your other entries are untouched)
"""
import json
import os
import re
import sys

PLUGIN_ID = "io.github.woogy7.workspaces"
XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
CONFIG = os.path.join(XDG_CONFIG, "omarchy", "shell.json")
HERE = os.path.dirname(os.path.realpath(__file__))
MENU_SNIPPET = os.path.join(HERE, "omarchy-menu.jsonc")
MENU_TARGET = os.path.join(XDG_CONFIG, "omarchy", "extensions", "omarchy-menu.jsonc")
MENU_START = "// --- Workspace Switcher (managed by io.github.woogy7.workspaces"
MENU_END = "// --- end Workspace Switcher ---"
MENU_EMPTY = ("{\n  // Extend the Quickshell Omarchy menu with JSONC. IDs are object keys; dotted\n"
              "  // ids imply hierarchy. See the Omarchy defaults for the full field list.\n}\n")

DEFAULTS = {
    "layout": "ribbon",
    "previewWidth": 320,
    "minPreviewWidth": 200,
    "gap": 28,
    "monitors": "all",
    "minWorkspaces": 5,
    "maxWorkspaces": 10,
    "showWallpaper": True,
    "showLabels": True,
    "showHints": True,
    "hoverSelects": True,
    "tapAction": "browse",
    "animations": True,
    "animationDuration": 160,
    "fadeDuration": 140,
    "selectedScale": 1.0,
    "unselectedScale": 1.0,
    "unselectedOpacity": 1.0,
}


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def load():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"version": 1, "plugins": []}
    except json.JSONDecodeError as e:
        die(f"{CONFIG}: {e}")


def save(cfg):
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.replace(tmp, CONFIG)


def entry(cfg, create=False):
    plugins = cfg.setdefault("plugins", [])
    for e in plugins:
        if isinstance(e, dict) and e.get("id") == PLUGIN_ID:
            return e
    if not create:
        return None
    e = {"id": PLUGIN_ID}
    plugins.append(e)
    return e


def parse(value, key):
    default = DEFAULTS.get(key)
    v = value.strip()
    low = v.lower()
    if isinstance(default, bool) or low in ("true", "false", "on", "off", "yes", "no"):
        return low in ("true", "on", "yes", "1")
    if isinstance(default, (int, float)) or default is None:
        try:
            return int(v)
        except ValueError:
            try:
                return float(v)
            except ValueError:
                pass
    return v


def fmt(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, float) and v == int(v):
        return str(v)  # keep 1.0 as 1.0 so menu checks stay stable
    return str(v)


def menu_block_present(text):
    return text.find(MENU_START) != -1


def menu_apply(remove):
    """Install/refresh (or remove) the marker-delimited menu block."""
    block = "" if remove else open(MENU_SNIPPET).read().rstrip("\n") + "\n"
    os.makedirs(os.path.dirname(MENU_TARGET), exist_ok=True)
    text = open(MENU_TARGET).read() if os.path.exists(MENU_TARGET) else MENU_EMPTY

    s = text.find(MENU_START)
    if s != -1:
        s = text.rfind("\n", 0, s) + 1   # from the start of the marker line
        e = text.find(MENU_END, s)
        if e == -1:
            die(f"{MENU_TARGET}: found start marker but no end marker; fix by hand")
        e = text.find("\n", e)
        e = len(text) if e == -1 else e + 1
        if remove and s > 1 and text[s - 1] == "\n" and text[s - 2] == "\n":
            s -= 1   # eat the blank line we added before the block
        text = text[:s] + block + text[e:]
    elif not remove:
        m = None
        for m in re.finditer(r"\}\s*$", text):
            pass
        if not m:
            die(f"{MENU_TARGET}: could not find the closing brace to insert before")
        head = text[:m.start()].rstrip("\n") + "\n"
        stripped = head.rstrip()
        if stripped.endswith("}") and not stripped.endswith("},"):
            head = stripped + ",\n"   # JSONC allows trailing commas
        text = head + "\n" + block + "}\n"
    else:
        print("menu block not present; nothing to remove")
        return

    tmp = MENU_TARGET + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, MENU_TARGET)
    print(("removed from " if remove else "installed into ") + MENU_TARGET)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = argv[1]
    cfg = load()

    if cmd == "show":
        e = entry(cfg) or {}
        eff = dict(DEFAULTS)
        eff.update({k: v for k, v in e.items() if k != "id"})
        print(json.dumps(eff, indent=2))
        return 0

    if cmd == "get":
        if len(argv) != 3:
            die("usage: switcher-config get <key>")
        key = argv[2]
        e = entry(cfg) or {}
        if key in e:
            print(fmt(e[key]))
        elif key in DEFAULTS:
            print(fmt(DEFAULTS[key]))
        else:
            die(f"unknown key: {key}")
        return 0

    if cmd == "set":
        if len(argv) != 4:
            die("usage: switcher-config set <key> <value>")
        key, raw = argv[2], argv[3]
        if key not in DEFAULTS:
            die(f"unknown key: {key} (known: {', '.join(sorted(DEFAULTS))})")
        e = entry(cfg, create=True)
        e[key] = parse(raw, key)
        save(cfg)
        print(f"{key} = {fmt(e[key])}")
        return 0

    if cmd == "toggle":
        if len(argv) != 3:
            die("usage: switcher-config toggle <key>")
        key = argv[2]
        if not isinstance(DEFAULTS.get(key), bool):
            die(f"not a boolean key: {key}")
        e = entry(cfg, create=True)
        current = e.get(key, DEFAULTS[key])
        e[key] = not (current is True or str(current).lower() == "true")
        save(cfg)
        print(f"{key} = {fmt(e[key])}")
        return 0

    if cmd == "unset":
        if len(argv) != 3:
            die("usage: switcher-config unset <key>")
        e = entry(cfg)
        if e and argv[2] in e:
            del e[argv[2]]
            save(cfg)
        return 0

    if cmd == "bar":
        mode = argv[2] if len(argv) > 2 else "status"
        bar = cfg.setdefault("bar", {})
        layout = bar.setdefault("layout", {})
        for sec in ("left", "center", "right"):
            layout.setdefault(sec, [])
        present = [(sec, i) for sec in ("left", "center", "right")
                   for i, e in enumerate(layout[sec]) if isinstance(e, dict) and e.get("id") == PLUGIN_ID]
        if mode == "status":
            print("on" if present else "off")
            return 0
        if mode == "toggle":
            mode = "off" if present else "on"
        if mode == "on":
            if not present:
                right = layout["right"]
                # Sit next to the Vitals chip when it is there, else at the end.
                after = [i for i, e in enumerate(right) if isinstance(e, dict) and e.get("id") == "io.github.woogy7.vitals"]
                right.insert(after[0] + 1 if after else len(right), {"id": PLUGIN_ID})
                save(cfg)
            print("bar icon: on")
            return 0
        if mode == "off":
            for sec, i in sorted(present, key=lambda x: -x[1]):
                del layout[sec][i]
            if present:
                save(cfg)
            print("bar icon: off")
            return 0
        die("usage: switcher-config bar [on|off|toggle|status]")

    if cmd == "menu":
        mode = argv[2] if len(argv) > 2 else "status"
        if mode == "status":
            text = open(MENU_TARGET).read() if os.path.exists(MENU_TARGET) else ""
            print("installed" if menu_block_present(text) else "not installed")
            return 0
        if mode in ("install", "remove"):
            menu_apply(mode == "remove")
            return 0
        die("usage: switcher-config menu [install|remove|status]")

    if cmd == "reset":
        e = entry(cfg)
        if e:
            for k in [k for k in e if k != "id"]:
                del e[k]
            save(cfg)
        return 0

    die(f"unknown command: {cmd}")


if __name__ == "__main__":
    sys.exit(main(sys.argv))
