#!/usr/bin/env python3
"""Install (or refresh / remove) the Workspace Switcher settings menu.

Merges omarchy-menu.jsonc from this plugin into
~/.config/omarchy/extensions/omarchy-menu.jsonc between marker comments, so
re-running updates the block in place and never touches your other entries.
The Omarchy menu watches that file, so the new Setup > Workspace Switcher
submenu appears immediately.

  install-menu            install or refresh
  install-menu --remove   remove the block
"""
import os
import re
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
SNIPPET = os.path.join(HERE, "omarchy-menu.jsonc")
TARGET = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                      "omarchy", "extensions", "omarchy-menu.jsonc")
START = "// --- Workspace Switcher (managed by io.github.woogy7.workspaces"
END = "// --- end Workspace Switcher ---"
EMPTY = "{\n  // Extend the Quickshell Omarchy menu with JSONC. IDs are object keys; dotted\n  // ids imply hierarchy. See the Omarchy defaults for the full field list.\n}\n"


def main(argv):
    remove = "--remove" in argv
    block = "" if remove else open(SNIPPET).read().rstrip("\n") + "\n"

    os.makedirs(os.path.dirname(TARGET), exist_ok=True)
    text = open(TARGET).read() if os.path.exists(TARGET) else EMPTY

    s = text.find(START)
    if s != -1:
        s = text.rfind("\n", 0, s) + 1   # replace from the start of the marker line
        e = text.find(END, s)
        if e == -1:
            sys.exit(f"{TARGET}: found start marker but no end marker; fix by hand")
        e = text.find("\n", e)
        e = len(text) if e == -1 else e + 1
        # Eat one blank line we may have added before the block.
        if s > 0 and text[s - 1] == "\n" and s > 1 and text[s - 2] == "\n" and block == "":
            s -= 1
        text = text[:s] + block + text[e:]
    elif not remove:
        m = None
        for m in re.finditer(r"\}\s*$", text):
            pass
        if not m:
            sys.exit(f"{TARGET}: could not find the closing brace to insert before")
        head = text[:m.start()].rstrip("\n") + "\n"
        # Make sure the previous entry ends with a comma (JSONC allows trailing ones).
        stripped = head.rstrip()
        if stripped and not stripped.endswith(("{", ",")) and not stripped.endswith("}"):
            pass
        if stripped.endswith("}") and not stripped.endswith("},"):
            head = stripped + ",\n"
        text = head + "\n" + block + "}\n"
    else:
        print("menu block not present; nothing to remove")
        return 0

    with open(TARGET, "w") as f:
        f.write(text)
    print(("removed from " if remove else "installed into ") + TARGET)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
